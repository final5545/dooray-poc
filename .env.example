# 복사해서 .env 로 쓰고 실제 값을 채운다. .env 는 git에 올라가지 않는다.

# Dooray 개인 액세스 토큰 (설정 > API > 개인 액세스 토큰)
DOORAY_TOKEN=

# 채널 라우팅. '채널ID:handler' 쉼표 구분. handler = crm | support
DOORAY_ROUTES=

# support 라우트가 있을 때 필수 — 티켓을 등록할 프로젝트 ID
DOORAY_SUPPORT_PROJECT=

# LLM 보강 (선택). 미설정이면 규칙 기반만으로 동작한다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# 현황판 프로젝트 코드 — News에 섞여 오는 타 프로젝트 알림을 걸러내는 데 쓴다
DOORAY_SUPPORT_PROJECT_CODE=

# CRM 조회. 미설정이면 메모리 Fake로 동작한다.
#
#   CRM_KIND=infomax   사내 CRM 실 API (POST /PCH/LoadCustData)
#   CRM_KIND=http      GET 방식 — 모의 서버용
#                      python standalone/mock_crm.py 8900
CRM_KIND=infomax
CRM_BASE_URL=http://190.1.195.104:8001
CRM_TIMEOUT=2.5

# CRM_KIND=http 일 때만 쓰는 값
# CRM_URL_TEMPLATE={base}/customers/{code}
# CRM_RESULT_PATH=result

# 슬래시 커맨드 앱 토큰 — 메신저 > 내 이름 > 슬래시 커맨드 연동 에서 발급.
# 두레이가 보내는 요청이 진짜인지 검증한다. 비우면 검증을 건너뛰므로
# 외부에 열린 서버에서는 반드시 채울 것.
DOORAY_APP_TOKEN=

# 접수 알림을 띄울 기술 지원 대화방 ID (커맨드 서버용).
# 다른 방에서 낸 요청도 기술팀이 알 수 있게 한다.
DOORAY_SUPPORT_CHANNEL=

# ── 보안 (2026-09-10 회의 기본조건) ────────────────────────
#
# 승인 사용자. 쉼표로 구분한 organizationMemberId 목록.
# ⚠️ 비워 두면 제한하지 않는다 — 채널에 들어온 사람이면 누구나 쓸 수 있다.
#    실 고객정보를 다루는 환경에서는 반드시 채울 것.
#
# 이 숫자는 사람이 알 방법이 마땅치 않다. 손으로 적지 말고 도구를 쓴다.
#     python3 tools/승인명단.py            지금 명단을 이름과 함께 본다
#     python3 tools/승인명단.py 추가 정시욱  이름으로 찾아 넣는다
#     python3 tools/승인명단.py 빼기 정시욱  뺀다
DOORAY_ALLOWED_USERS=

# 감사로그 경로. 비우면 기록하지 않는다.
# 무엇을 조회했는지(고객번호)는 남기고 무엇이 나왔는지는 남기지 않는다.
DOORAY_AUDIT_LOG=
