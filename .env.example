# 복사해서 .env 로 쓰고 실제 값을 채운다. .env 는 git에 올라가지 않는다.

# Dooray 개인 액세스 토큰 (설정 > API > 개인 액세스 토큰)
DOORAY_TOKEN=

# 채널 라우팅. '채널ID:handler' 쉼표 구분. handler = crm | support
DOORAY_ROUTES=

# support 라우트가 있을 때 필수 — 티켓을 등록할 프로젝트 ID
DOORAY_SUPPORT_PROJECT=

# LLM 보강 (선택). 미설정이면 규칙 기반만으로 동작한다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# 현황판 프로젝트 코드 — News에 섞여 오는 타 프로젝트 알림을 걸러내는 데 쓴다
DOORAY_SUPPORT_PROJECT_CODE=

# CRM 조회. 미설정이면 메모리 Fake로 동작한다.
# 모의 서버: python standalone/mock_crm.py 8900
CRM_BASE_URL=
CRM_URL_TEMPLATE={base}/customers/{code}
CRM_RESULT_PATH=result
CRM_TIMEOUT=2.5

# 슬래시 커맨드 앱 토큰 — 메신저 > 내 이름 > 슬래시 커맨드 연동 에서 발급.
# 두레이가 보내는 요청이 진짜인지 검증한다. 비우면 검증을 건너뛰므로
# 외부에 열린 서버에서는 반드시 채울 것.
DOORAY_APP_TOKEN=
